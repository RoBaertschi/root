{
	"folders":
	[
		{
			"path": "."
		}
	],
	"build_systems": [
		{
			"name": "Run",
			"shell_cmd": "odin run . -debug",
			"file_regex": "^(.+)\\(([0-9]+):([0-9]+)\\) (.+)$",
			"working_dir": "$project_path"
		},
		{
			"name": "Build",
			"shell_cmd": "odin build . -debug",
			"file_regex": "^(.+)\\(([0-9]+):([0-9]+)\\) (.+)$",
			"working_dir": "$project_path"
		}
	]
}
